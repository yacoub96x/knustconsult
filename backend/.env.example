# Database Connection String for Prisma (SQLite)
DATABASE_URL="file:./dev.db"

# JWT Secret Key for token signing
JWT_SECRET="knust_consult_secret_jwt_key_2026_super_secure"

# Server Port
PORT=5000

# Frontend URL for CORS configuration
FRONTEND_URL="http://localhost:5173"

# Optional SMTP Settings for Nodemailer (If omitted, emails log to backend console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@knust.edu.gh"

# Google Gemini API Key (Required for AI Voice Parsing feature)
GEMINI_API_KEY="your_gemini_api_key_here"
